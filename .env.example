# MongoDB (required for portfolio + admin)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/agency?retryWrites=true&w=majority

# NextAuth (required for admin session)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_long_random_string

# Cloudinary (required for image uploads from admin; see src/lib/adminUploadLimits.ts for max size per file)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=your_resend_api_key_here
# Optional OAuth (public site sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
